{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "noEmit": true
  },
  "include": [
    "src/media/**/*.ts",
    "src/protocol.ts",
    "src/audioEngine/worklets/messages.ts"
  ]
}
