{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "types": ["node", "vscode"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/media/**/*",
    "src/audioEngine/worklets/**/*"
  ]
}
