{
  "name": "white-noise",
  "displayName": "White Noise & Pomodoro",
  "description": "Procedural white/pink/brown noise, binaural beats, isochronic tones and solfeggio frequencies with an integrated Pomodoro timer.",
  "version": "0.0.1",
  "publisher": "shin1007",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shin1007/white-noise"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "white noise",
    "pink noise",
    "brown noise",
    "pomodoro",
    "binaural beats",
    "focus",
    "ambient sound"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "フェーズ終了スクリプト（extension host で JS を実行する機能）は、信頼済みワークスペースでのみ動作します。",
      "restrictedConfigurations": [
        "whiteNoise.enablePhaseEndScripts"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "whiteNoise.openPanel",
        "title": "White Noise: Open Panel"
      },
      {
        "command": "whiteNoise.play",
        "title": "White Noise: Play"
      },
      {
        "command": "whiteNoise.stop",
        "title": "White Noise: Stop"
      },
      {
        "command": "whiteNoise.pomodoro.start",
        "title": "White Noise: Start Pomodoro"
      },
      {
        "command": "whiteNoise.pomodoro.pause",
        "title": "White Noise: Pause Pomodoro"
      },
      {
        "command": "whiteNoise.pomodoro.reset",
        "title": "White Noise: Reset Pomodoro"
      },
      {
        "command": "whiteNoise.pomodoro.skipPhase",
        "title": "White Noise: Skip Pomodoro Phase"
      }
    ],
    "configuration": {
      "title": "White Noise & Pomodoro",
      "properties": {
        "whiteNoise.enablePhaseEndScripts": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Allow phase-end custom scripts to run. These execute as a JS function inside the extension host (Node) with access to a small vscode API subset -- only enable this if you wrote the script yourself. For safety this can only be set in your user settings (not per-workspace), and scripts run only in trusted workspaces."
        },
        "whiteNoise.statusBar.updateIntervalMs": {
          "type": "number",
          "default": 1000,
          "description": "Pomodoro status bar tick interval in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.worklet.json",
    "lint": "eslint .",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "pretest": "npm run compile-tests && npm run build",
    "test": "node ./scripts/run-integration-tests.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "mocha": "^10.7.3",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.64.0"
  }
}
